CREATE DATABASE AnimeDatabase;
USE AnimeDatabase;

Create TABLE users(
    id INT AUTO_INCREMENT PRIMARY KEY,
    -- using not null makes the field mantitory input, and useing unique makes the username have to be unique so the this can be used for logins
	username varchar (50) NOT NULL UNIQUE,
	email varchar (100) NOT NULL UNIQUE,
	password_hash VARCHAR(255) NOT NULL, 
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS anime (
    id INT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(150) NOT NULL,
    type ENUM('Anime', 'Manga') NOT NULL DEFAULT 'Anime',
    genre VARCHAR(50) NOT NULL,
    release_year INT NOT NULL,
    status ENUM('Watching', 'Completed', 'Plan to Watch') NOT NULL DEFAULT 'Plan to Watch',
    rating DECIMAL(3,1) DEFAULT 0.0,
    synopsis TEXT
);
